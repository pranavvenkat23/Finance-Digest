{
  "expo": {
    "name": "Finance Digest",
    "slug": "finance-digest",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "financedigest",
    "userInterfaceStyle": "automatic",
    "description": "Finance Digest shows where your federal, state, and local taxes go, the real federal grants and contracts funding work in your ZIP, and how markets and news affect your money. A civic-education estimate built on official data, every number is sourced. Not tax-filing software and not tax advice.",
    "primaryColor": "#BE4A2F",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.pranav.financedigest",
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Finance Digest can use your location only to auto-fill your ZIP code. This is optional, you can always type your ZIP. Your location never leaves your device.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.pranav.financedigest",
      "adaptiveIcon": {
        "backgroundColor": "#14243B",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "config": {
        "googleMaps": {
          "apiKey": "REPLACE_WITH_ANDROID_GOOGLE_MAPS_API_KEY"
        }
      }
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#14243B",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120,
          "dark": {
            "backgroundColor": "#0E1622",
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 120
          }
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Finance Digest can use your location only to auto-fill your ZIP code. This is optional."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
